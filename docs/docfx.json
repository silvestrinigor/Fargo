{
  "metadata": [
    {
      "src": [
        {
          "src": "src",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0",
        "NuGetAudit": "false",
        "TreatWarningsAsErrors": "false"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "README.md"
        ]
      },
      {
        "files": [
          "**/*.swagger.json"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "img/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "Fargo",
      "_appTitle": "Fargo",
      "_enableSearch": true,
      "pdf": true
    }
  }
}