@using ModelContextProtocol.Client
@inject McpSession Mcp

<div class="panel">
    @if (_error is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">@_error</FluentMessageBar>
    }
    else if (_tools is null)
    {
        <FluentProgressRing />
    }
    else
    {
        <p>@_tools.Count tools exposed by the Fargo MCP server for your user.</p>
        @foreach (var tool in _tools)
        {
            <FluentCard Class="tool-card">
                <strong>@tool.Name</strong>
                @if (ChatService.IsWriteTool(tool.Name))
                {
                    <FluentBadge Appearance="Appearance.Accent">writes data</FluentBadge>
                }
                <div>@tool.Description</div>
            </FluentCard>
        }
    }
</div>

@code {
    private IReadOnlyList<McpClientTool>? _tools;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _tools = await Mcp.GetToolsAsync();
        }
        catch (Exception ex)
        {
            _error = $"Could not reach the MCP server: {ex.Message}";
        }
    }
}
