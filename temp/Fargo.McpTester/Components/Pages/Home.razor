@page "/"
@inject UserSession Session
@inject NavigationManager Navigation

<PageTitle>Fargo MCP Tester</PageTitle>

@if (Session.IsAuthenticated)
{
    <FluentTabs>
        <FluentTab Label="Chat" Id="tab-chat">
            <ChatPanel />
        </FluentTab>
        <FluentTab Label="Tools" Id="tab-tools">
            <ToolsPanel />
        </FluentTab>
    </FluentTabs>
}

@code {
    protected override void OnInitialized()
    {
        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
        }
    }
}
