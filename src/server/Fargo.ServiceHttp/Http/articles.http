@articleGuid = 8d9e5ba7-9a2b-49fe-a6ed-5b134e9e3d74
@partitionGuid = 55555555-5555-5555-5555-555555555555

### Get by Guid

GET {{host}}/v1/articles/{{articleGuid}}
Authorization: Bearer {{jwt}}

###

### Get inventory by Guid

GET {{host}}/v1/articles/{{articleGuid}}/inventory
Authorization: Bearer {{jwt}}

###

### Get by Barcode

GET {{host}}/v1/articles/7891234567895:Ean13
Authorization: Bearer {{jwt}}

###

### List

GET {{host}}/v1/articles?page=1&limit=20
Authorization: Bearer {{jwt}}

###

### Create

POST {{host}}/v1/articles
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
  "name": "article Test fasdf",
  "articleType": 1,
  "barcode": {
    "ean13": "1234567891234"
  }
}

###

### Patch

PATCH {{host}}/v1/articles/{{articleGuid}}
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
  "description": "Updated description",
  "barcode":{
    //"ean13": "9876543211231"
    "removeEan13": true
  }
}

###

### Delete

DELETE {{host}}/v1/articles/{{articleGuid}}
Authorization: Bearer {{jwt}}