{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ArticleImage": {},
    "RateLimiting": {
        "Enabled": true,
        "Global": { "PermitLimit": 300, "WindowSeconds": 60, "QueueLimit": 0 },
        "GeneralAuthenticated": { "PermitLimit": 100, "WindowSeconds": 60, "QueueLimit": 0 },
        "IdentityLogin": { "PermitLimit": 10, "WindowSeconds": 60, "QueueLimit": 0 },
        "IdentityRefresh": { "PermitLimit": 30, "WindowSeconds": 60, "QueueLimit": 0 },
        "IdentityDefault": { "PermitLimit": 10, "WindowSeconds": 60, "QueueLimit": 0 }
    }
}
