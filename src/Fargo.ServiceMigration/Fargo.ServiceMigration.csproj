<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>dotnet-Fargo.MigrationService-778fe58d-4d19-4198-8805-caabfe0fc1bf</UserSecretsId>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
        <!-- Pin patched version to resolve transitive vulnerability GHSA-846f-f764-76mx (CVE-2026-84008). -->
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Fargo.Infrastructure\Fargo.Infrastructure.csproj" />
        <ProjectReference Include="..\Fargo.ServiceDefaults\Fargo.ServiceDefaults.csproj" />
    </ItemGroup>
</Project>
