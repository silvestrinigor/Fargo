<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!--
      Version of the `fargo` CLI tool. Independent of the other artifacts in
      this repo. Pre-1.0 with a prerelease suffix: Fargo is still in active
      development, so the surface may change at any time. The release workflow
      overrides this from the git tag (e.g. -p:Version=0.1.0-alpha.2).
    -->
    <Version>0.1.0-alpha.1</Version>

    <!--
      The shipped command is `fargo` (fargo.exe on Windows). The CLI's own help
      and the generated docs already assume this name.
    -->
    <AssemblyName>fargo</AssemblyName>

    <!--
      Distribution targets. Release binaries are self-contained single files so
      end users do not need the .NET runtime installed. Trimming and NativeAOT
      are intentionally left off: the CLI uses reflection-based DI and
      Microsoft.Extensions.Hosting, which are not trim/AOT-safe without extra
      work. Revisit once that is addressed.
    -->
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>

    <!-- Ship only the single executable: keep referenced-project .pdb files out of publish output. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>

    <!-- Keep the reported version clean (e.g. 0.1.0-alpha.1, not 0.1.0-alpha.1+<commit>). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ktsu.CredentialCache" Version="1.3.31" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="System.CommandLine" Version="2.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fargo.ClientHttp\Fargo.ClientHttp.csproj" />
  </ItemGroup>

</Project>
