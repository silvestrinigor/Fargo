@articleGuid = 11111111-1111-1111-1111-111111111111
@itemGuid = 22222222-2222-2222-2222-222222222222
@partitionGuid = 55555555-5555-5555-5555-555555555555

### Get

GET {{host}}/items/{{itemGuid}}
Authorization: Bearer {{jwt}}

###

### List

GET {{host}}/items?page=1&limit=20
Authorization: Bearer {{jwt}}

###

### Create

POST {{host}}/items
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
  "articleGuid": "{{articleGuid}}",
  "partitions": [
    "{{partitionGuid}}"
  ]
}

###

### Update

PATCH {{host}}/items/{{itemGuid}}
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
  "partitions": [
    "{{partitionGuid}}"
  ],
  "parentContainerGuid": null
}

###

### Delete

DELETE {{host}}/items/{{itemGuid}}
Authorization: Bearer {{jwt}}