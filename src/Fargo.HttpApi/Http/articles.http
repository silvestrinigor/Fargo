@articleGuid = 9a496658-2645-4f3c-8e4b-9fb27a704257
@partitionGuid = 55555555-5555-5555-5555-555555555555

### Get by Guid

GET {{host}}/articles/{{articleGuid}}
Authorization: Bearer {{jwt}}

###

### Get by Barcode

GET {{host}}/articles/7891234567895:Ean13
Authorization: Bearer {{jwt}}

###

### List

GET {{host}}/articles?page=1&limit=20
Authorization: Bearer {{jwt}}

###

### Create

POST {{host}}/articles
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
  "name": "Coca Cola 2L",
  "description": "PET Bottle",
  "articleType": 3,
  "pack": {
    "fromArticleGuid": "9a496658-2645-4f3c-8e4b-9fb27a704257",
    "quantity": 2
  },
  "partitionsToAdd": ["00000000-0000-0000-0000-000000000002"]
}

###

### Patch

PATCH {{host}}/articles/{{articleGuid}}
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
  "description": "Updated description"
}

###

### Delete

DELETE {{host}}/articles/{{articleGuid}}
Authorization: Bearer {{jwt}}