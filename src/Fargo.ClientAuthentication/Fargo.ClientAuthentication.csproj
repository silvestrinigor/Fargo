<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>

    <!--
      Token storage and refresh shared by the Fargo client libraries
      (Fargo.ClientHttp, Fargo.ClientRealtime). Deliberately free of Kiota and
      SignalR so either client can use it without pulling in the other.
    -->
    <Version>0.1.0-alpha.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Fargo.ClientAuthentication.Tests" />
  </ItemGroup>

</Project>
