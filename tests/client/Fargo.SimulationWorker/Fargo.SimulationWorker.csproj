<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!--
      Internal client-activity simulation worker. Not a shipped artifact, so it
      has no independent version and is excluded from packaging. It drives the
      real HTTP API of a running Fargo instance in a long-running loop to
      generate realistic client/user history.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\client\Fargo.ClientHttp\Fargo.ClientHttp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Configuration source of truth: ship it next to the binary. -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
